# SafePlant FastAPI Backend Environment Configuration

# Database
SAFEPLANT_DB_PATH=backend/safeplant.db

# Server Host & Port
PORT=8000
HOST=0.0.0.0

# Firebase Cloud Messaging (FCM)
# Place your Firebase service account private key JSON string or path here
FIREBASE_SERVICE_ACCOUNT_JSON=

# MSG91 SMS Gateway (India)
# Retrieve from https://control.msg91.com
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=SAFEPL
